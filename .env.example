# Tales of Two frontend — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it is
# the one place the set of required variables is written down.
#
#     cp .env.example .env
#
# EXPO_PUBLIC_ prefix is required. Expo only inlines variables carrying it into
# the client bundle; a variable without the prefix is simply `undefined` at
# runtime, with no build error to tell you. Anything here is therefore PUBLIC —
# it ships inside the app bundle and can be read by anyone who installs it.
# Never put a secret, private key or admin token in this file or in `.env`.

# Base URL of the Tales of Two API, no trailing slash.
#
# Android emulators cannot reach the host's `localhost` — 10.0.2.2 is the
# emulator's alias for it. iOS simulators and web can use localhost directly.
#   web / iOS simulator : http://localhost:3000
#   Android emulator    : http://10.0.2.2:3000
#   physical device     : http://<your-LAN-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Realtime endpoint for chat (typing indicators, message delivery).
# Leave blank until the server exposes one — `src/config/env.ts` treats an
# empty value as "not available yet" rather than failing to boot.
EXPO_PUBLIC_WS_URL=
